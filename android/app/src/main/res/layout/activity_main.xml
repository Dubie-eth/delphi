<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="144dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/silhouette"
            android:tint="@color/gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="serif"
            android:text="@string/main_title"
            android:textColor="@color/gold"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="serif"
            android:text="@string/node_title"
            android:textColor="@color/gold"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/node_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_bg"
            android:lineSpacingMultiplier="1.2"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/node_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/node_start" />

        <CheckBox
            android:id="@+id/node_autorestart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="@string/node_autorestart"
            android:textSize="14sp" />

        <Button
            android:id="@+id/node_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/node_link" />

        <Button
            android:id="@+id/node_copy_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/node_copy_link" />

        <EditText
            android:id="@+id/node_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/node_code_hint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:maxLines="3"
            android:textColor="@color/text"
            android:textColorHint="#80E8E1CF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/node_code_use"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/node_code_use" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/node_howto"
            android:textColor="#B3E8E1CF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="serif"
            android:text="@string/widgets_title"
            android:textColor="@color/gold"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/main_howto"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/widget_bg"
            android:padding="16dp"
            android:text="@string/no_widgets"
            android:textColor="@color/gold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/refresh" />

        <Button
            android:id="@+id/open_site"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_site" />
    </LinearLayout>
</ScrollView>
