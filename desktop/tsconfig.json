{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@delphi/*": ["../app/*"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "@upstash/redis": ["src/shims/upstash-redis.d.ts"],
      "viem": ["node_modules/viem"],
      "viem/*": ["node_modules/viem/*"]
    }
  },
  "include": [
    "src",
    "../app/components/ProfilePicturePicker.tsx",
    "../app/lib/testnet.ts",
    "../app/lib/genesisMarket.ts",
    "../app/lib/genesisTokenScan.ts",
    "../app/lib/genesisNodeBond.ts",
    "../app/lib/nodeBatchAnchor.ts",
    "../app/lib/guardianRegistry.ts",
    "../app/lib/nftProfileScan.ts",
    "../app/lib/nftUri.ts",
    "../app/lib/nodeProfileStorage.ts",
    "../app/node/freivaldsCore.ts",
    "../app/node/batteryGate.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
